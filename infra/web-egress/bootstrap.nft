table inet web_egress {
    set dns_v4 {
        type ipv4_addr
    }

    set dns_v6 {
        type ipv6_addr
    }

    set dns_listener_udp_v4 {
        type ipv4_addr . inet_service
    }

    set dns_listener_tcp_v4 {
        type ipv4_addr . inet_service
    }

    set dns_listener_udp_v6 {
        type ipv6_addr . inet_service
    }

    set dns_listener_tcp_v6 {
        type ipv6_addr . inet_service
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        iifname "lo" ip daddr . udp dport @dns_listener_udp_v4 accept
        iifname "lo" ip daddr . tcp dport @dns_listener_tcp_v4 accept
        iifname "lo" ip6 daddr . udp dport @dns_listener_udp_v6 accept
        iifname "lo" ip6 daddr . tcp dport @dns_listener_tcp_v6 accept
        ip6 hoplimit 255 icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        icmpv6 type packet-too-big accept
    }

    chain output {
        type filter hook output priority mangle; policy drop;

        ct state established,related accept
        ip daddr @dns_v4 udp dport 53 accept
        ip daddr @dns_v4 tcp dport 53 accept
        ip6 daddr @dns_v6 udp dport 53 accept
        ip6 daddr @dns_v6 tcp dport 53 accept
        ip6 hoplimit 255 ip6 daddr { ff02::/16, fe80::/10 } icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        icmpv6 type packet-too-big accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
