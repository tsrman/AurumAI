# hermes-egress guard: generated sets are added by the entrypoint in hermes mode.
table inet web_egress {
    set forbidden_v4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.88.99.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    set forbidden_v6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = {
            ::/128,
            ::1/128,
            ::ffff:0:0/96,
            64:ff9b::/96,
            64:ff9b:1::/48,
            100::/64,
            2001::/23,
            2001:db8::/32,
            2002::/16,
            3fff::/20,
            fc00::/7,
            fe80::/10,
            fec0::/10,
            ff00::/8
        }
    }

    set operator_forbidden_v4 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set operator_forbidden_v6 {
        type ipv6_addr
        flags interval
        auto-merge
    }

    set host_gateway_v4 {
        type ipv4_addr
    }

    set host_gateway_v6 {
        type ipv6_addr
    }

    set dns_v4 {
        type ipv4_addr
    }

    set dns_v6 {
        type ipv6_addr
    }

    set dns_listener_udp_v4 {
        type ipv4_addr . inet_service
    }

    set dns_listener_tcp_v4 {
        type ipv4_addr . inet_service
    }

    set dns_listener_udp_v6 {
        type ipv6_addr . inet_service
    }

    set dns_listener_tcp_v6 {
        type ipv6_addr . inet_service
    }

    set internal_tcp_v4 {
        type ipv4_addr . inet_service
    }

    set internal_tcp_v6 {
        type ipv6_addr . inet_service
    }

    set sandbox_v4 {
        type ipv4_addr
        flags interval
    }

    set sandbox_v6 {
        type ipv6_addr
        flags interval
    }

    set sandbox_tcp_ports {
        type inet_service
    }

    set public_tcp_ports {
        type inet_service
    }

    set local_tcp_ports {
        type inet_service
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related counter accept
        iifname "lo" ip saddr 127.0.0.1 tcp dport @local_tcp_ports accept
        iifname "lo" ip6 saddr ::1 tcp dport @local_tcp_ports accept
        iifname "lo" ip daddr . udp dport @dns_listener_udp_v4 counter accept
        iifname "lo" ip daddr . tcp dport @dns_listener_tcp_v4 counter accept
        iifname "lo" ip6 daddr . udp dport @dns_listener_udp_v6 counter accept
        iifname "lo" ip6 daddr . tcp dport @dns_listener_tcp_v6 counter accept
        ip saddr @sandbox_v4 tcp dport @sandbox_tcp_ports accept
        ip6 saddr @sandbox_v6 tcp dport @sandbox_tcp_ports accept
        ip6 hoplimit 255 icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        icmpv6 type packet-too-big accept
        counter reject
    }

    chain output {
        # Run after conntrack (-200) but before Docker's DNS DNAT (-100), so
        # the exact resolver destination still has its original port 53.
        type filter hook output priority mangle; policy drop;

        ct state established,related counter accept
        oifname "lo" ip daddr 127.0.0.1 tcp dport @local_tcp_ports accept
        oifname "lo" ip6 daddr ::1 tcp dport @local_tcp_ports accept
        ip daddr @dns_v4 udp dport 53 counter accept
        ip daddr @dns_v4 tcp dport 53 counter accept
        ip6 daddr @dns_v6 udp dport 53 counter accept
        ip6 daddr @dns_v6 tcp dport 53 counter accept
        ip daddr . tcp dport @internal_tcp_v4 accept
        ip6 daddr . tcp dport @internal_tcp_v6 accept
        ip6 hoplimit 255 ip6 daddr { ff02::/16, fe80::/10 } icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        icmpv6 type packet-too-big accept
        ip daddr @host_gateway_v4 reject
        ip6 daddr @host_gateway_v6 reject
        ip daddr @operator_forbidden_v4 reject
        ip6 daddr @operator_forbidden_v6 reject
        ip daddr @forbidden_v4 reject
        ip6 daddr @forbidden_v6 reject
        tcp dport @public_tcp_ports accept
        counter reject
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
