APP_DEBUG=true
APP_IDENTITY_SYNC_ENABLED=false
APP_IDENTITY_SYNC_WAIT_SECONDS=10
# Enable only after verified archive storage and lifecycle worker readiness.
APP_ARCHIVE_ENABLED=false
APP_ARCHIVE_RETENTION_DAYS=180
APP_ARCHIVE_SWEEP_INTERVAL_SECONDS=86400
APP_ARCHIVE_BATCH_SIZE=100
APP_NAME="AurumAI Business Backend"
APP_BIND=0.0.0.0:8000
APP_WORKERS=4
APP_FRONTEND_URL=http://localhost:3000
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aurum_ai
APP_REDIS_URL=redis://localhost:6379/0
APP_KEYCLOAK_URL=http://localhost:8080
# APP_KEYCLOAK_ISSUER=http://localhost:8080/realms/aurum-ai
APP_KEYCLOAK_REALM=aurum-ai
APP_KEYCLOAK_CLIENT_ID=business-ui
APP_KEYCLOAK_CLIENT_SECRET=
APP_LLM_GATEWAY_URL=http://localhost:8000
APP_GATEWAY_API_KEY=
# APP_GATEWAY_VERIFY_SSL=true
# APP_GATEWAY_CA_CERT=/path/to/corporate-ca.pem
APP_S3_ENDPOINT=
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_BUCKET=aurum-ai-business
APP_RATE_LIMIT_PER_MINUTE=100
APP_RATE_LIMIT_PER_MINUTE_STREAM=30
# Durable user-question waits: refresh the existing exact-owned runner every
# 30s, rotate its 30-minute identity token after 20 minutes, and retain an
# answered/deadline settlement for at most five minutes.
APP_RUNNER_TOKEN_REFRESH_AFTER_SECONDS=1200
APP_INTERACTION_MAINTENANCE_INTERVAL_SECONDS=30
APP_INTERACTION_SETTLEMENT_GRACE_SECONDS=300

# Secret key for signing runner session tokens. Generate: openssl rand -hex 32
APP_SECRET_KEY=dev-secret-DO-NOT-USE-IN-PRODUCTION

# Operator/data worker only; do not inject archive credentials into API containers.
APP_ARCHIVE_S3_ENDPOINT=http://minio:9000
APP_ARCHIVE_S3_ACCESS_KEY=
APP_ARCHIVE_S3_SECRET_KEY=
APP_ARCHIVE_S3_BUCKET=aurum-ai-archives
APP_ARCHIVE_S3_REGION=us-east-1
APP_ARCHIVE_RAG_SERVICE_SECRET=
APP_ARCHIVE_RAG_URL=http://rag-archive:8111
