# Development configuration. Run ./scripts/bootstrap-dev-env.sh first.
# Generated secrets are stored in ignored .env, never in this example.
APP_DEBUG=true
APP_SECRET_KEY=
APP_DATABASE_ROLE_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
RAG_APP_DB_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=
CLICKHOUSE_PASSWORD=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=AurumAI Admin
LANGFUSE_INIT_ORG_NAME=AurumAI
LANGFUSE_INIT_PROJECT_NAME=AurumAI

# Browser-visible host; localhost is suitable for a browser on the Docker host.
PUBLIC_HOST=localhost
# Host address for browser-facing ports. Docker-published ports bypass host
# firewalls; widen this only on a trusted network, or use the proxy overlay.
PUBLIC_BIND_ADDRESS=127.0.0.1
RUNTIME_SOURCE_CODE_URL=

# Reverse proxy overlay (docker-compose.proxy.yml): Traefik with Let's Encrypt
# serves chat/admin/api/admin-api/auth/temporal/langfuse subdomains of PUBLIC_DOMAIN.
PUBLIC_DOMAIN=
ACME_EMAIL=
TEMPORAL_UI_BASIC_AUTH_USER=operator
TEMPORAL_UI_BASIC_AUTH_PASSWORD=

# Empty credentials select the existing local mock mode.
LLM_GATEWAY_URL=http://backend:8000
GATEWAY_API_KEY=
OPENROUTER_API_KEY=
EVALUATOR_ENABLED=false
EVALUATOR_MODEL=

# Knowledge search waits this long for the query embedding (seconds). Raise it
# for a CPU-only embedding model on a memory-constrained host.
RAG_API_SEARCH_EMBEDDING_TIMEOUT_SECONDS=10

# Optional features keep their server-owned rollout gates.
USER_QUESTIONS_ENABLED=false
WEB_ENABLED=false
WEB_TOOLS_SERVICE_SECRET=
SEARXNG_SECRET=
APP_IDENTITY_SYNC_ENABLED=false
APP_IDENTITY_SYNC_WAIT_SECONDS=10
APP_ARCHIVE_ENABLED=false
APP_ARCHIVE_RETENTION_DAYS=180
APP_ARCHIVE_SWEEP_INTERVAL_SECONDS=86400
APP_ARCHIVE_BATCH_SIZE=20
